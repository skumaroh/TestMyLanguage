# Copy to .env for local runs. Never commit real values.

# PostgreSQL (required): jdbc:postgresql://HOST:5432/DBNAME?user=USER&password=PASSWORD&sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/tamil?user=your_user&password=your_password

# Which language this deployment serves: tamil or hindi
APP_LANGUAGE=tamil

# Azure Blob Storage: a container-scoped SAS connection string, or an account connection string for local use
AZURE_STORAGE_CONNECTION_STRING=your_storage_connection_string_here
# Optional: a blob the home page reads to prove access works
ASSESSMENT_BLOB_CHECK_CONTAINER=
ASSESSMENT_BLOB_CHECK_BLOB=

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@mylangskills.com

# Public URL used in email links
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:8080

# Optional stretch goal: Google sign-in
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=your_google_client_id_here
# SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=your_google_client_secret_here
