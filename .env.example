# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Azure Blob Storage Configuration
# Get connection string from Azure Portal > Storage Account > Access Keys
# Used for local multimedia asset previews and uploads (images, audio, video)
# Format: DefaultEndpointsProtocol=https;AccountName={accountName};AccountKey={accountKey};EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account_name;AccountKey=your_account_key;EndpointSuffix=core.windows.net

# Azure OpenAI image-generation deployment (Feature 4, image-generation doc §4.1) — gpt-image-1-mini
# on its own SEPARATE Azure resource, distinct from the text deployment's AZURE_OPENAI_ENDPOINT /
# AZURE_OPENAI_API_KEY (not documented in this example file yet — a pre-existing gap, not
# introduced here; see azure.openai.* in application.properties for the full text config). Uses
# the same unified v1 surface/Bearer auth as the text deployment, confirmed against Microsoft
# Foundry's own generated sample code for this deployment. AZURE_OPENAI_IMAGE_ENDPOINT can be set
# to either the bare resource root or the full .../openai/v1 string Foundry's portal displays.
AZURE_OPENAI_IMAGE_ENDPOINT=your_image_resource_endpoint_here
AZURE_OPENAI_IMAGE_API_KEY=your_image_resource_api_key_here
AZURE_OPENAI_IMAGE_DEPLOYMENT=your_image_deployment_name_here

# Local language selection for media auto-discovery
# Recommended: set this explicitly to match the dataset you are testing locally
APP_LANGUAGE=tamil

# Optional local database override
# If omitted, application.properties fallback is used
# DATABASE_URL=jdbc:postgresql://your-host:5432/tamil?user=your_user&password=your_password&sslmode=require

# OAuth Configuration
# MVP Scope: Only Google OAuth enabled. Facebook/Microsoft disabled for MVP.

# Google OAuth (ACTIVE - Required for MVP)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Facebook OAuth (MVP: DISABLED - Uncomment to enable in Phase 1.5)
#FACEBOOK_CLIENT_ID=your_facebook_app_id_here
#FACEBOOK_CLIENT_SECRET=your_facebook_app_secret_here

# Microsoft OAuth (MVP: DISABLED - Uncomment to enable in Phase 1.5)
#MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
#MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here

# Application URLs
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:8080
